---
import Layout from './layouts/Layouts.astro';

const listaProyectos = [
  { 
    nombre: "Guía Académica", 
    descripcion: "Consultoría enfocada en el asesoramiento metodológico y desarrollo de proyectos de investigación, operando bajo estricta confidencialidad profesional. Mi enfoque actual en el proyecto es mejorar la presencia digital mediante el desarrollo de interfaces web adaptativas y la evaluación continua de la usabilidad para generar mayor confianza en nuestros usuarios visitantes.",
    imagen: "/logos/logo_Guia_Academica.png",
    alt: "Logotipo oficial de la consultoría académica Guía Académica"
  },
  { 
    nombre: "Manitos Unidas", 
    descripcion: "Centro de terapia infantil integral donde gestiono toda el área de administración operativa, marketing, captación de clientes y logística. Además de diseñar las campañas publicitarias, actualmente trabajo en la modernización de los procesos del centro mediante la creación de landing pages y paneles administrativos utilizando tecnologías web modernas.",
    imagen: "/logos/Unidas.png",
    alt: "Logotipo del centro de terapia infantil Manitos Unidas"
  },
  { 
    nombre: "Ingeniería de Sistemas", 
    descripcion: "Formación académica universitaria enfocada en el desarrollo de software, estructuración de algoritmos y tecnologías como JavaScript, HTML y CSS. A través de la carrera he logrado materializar conocimientos teóricos en proyectos prácticos, desde sistemas de ventas y dispensadores IoT, buscando siempre aplicar la tecnología para resolver necesidades reales del mercado.",
    imagen: "/logos/UPN.png",
    alt: "Logotipo de la Universidad Privada del Norte"
  }
];
---

<Layout title="Proyectos | Portafolio">
  <main class="contenedor-proyectos">
    <h1>Mis Proyectos Actuales</h1>
    
    <section class="grid-proyectos">
      {listaProyectos.map((proyecto) => (
        <article class="tarjeta-proyecto">
          
          <div class="contenedor-imagen">
            <img src={proyecto.imagen} alt={proyecto.alt} />
          </div>
          <div class="contenido-tarjeta">
            <h2>{proyecto.nombre}</h2>
            <p>{proyecto.descripcion}</p>
          </div>
        </article>
      ))}
    </section>
  </main>
</Layout>

<style>
  .contenedor-proyectos {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem;
    font-family: system-ui, -apple-system, sans-serif;
  }

  h1 {
    text-align: center;
    color: #333;
    margin-bottom: 2.5rem;
  }

  .grid-proyectos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  /* Estructura de la tarjeta */
  .tarjeta-proyecto {
    background-color: #ffffff;
    border: 1px solid #eaeaeb;
    border-radius: 10px; 
    overflow: hidden; 
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .tarjeta-proyecto:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
  }

  /* Estilos específicos para que los logos se vean bien */
  .contenedor-imagen {
    width: 100%;
    height: 180px;
    background-color: #f8f9fa; /* Un fondo gris claro por si el logo es transparente */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    border-bottom: 1px solid #eaeaeb;
  }

  .contenedor-imagen img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain; /* Esto asegura que el logo no se deforme ni se recorte */
  }

  .contenido-tarjeta {
    padding: 1.5rem;
  }

  .contenido-tarjeta h2 {
    color: #0056b3;
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }

  .contenido-tarjeta p {
    color: #555;
    line-height: 1.6;
    margin: 0;
  }
</style>